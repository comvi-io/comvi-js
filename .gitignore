node_modules
dist
# ...except the dist-level canary suites, which are source, not build output.
!packages/core/tests/dist/
!packages/react/tests/dist/
!packages/next/tests/dist/
!packages/cli/tests/dist/
coverage
*.local
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env*

# Comvi config (contains API keys)
.comvirc.json

# Turbo
.turbo
.pnpm-store

# Next.js
.next
next-env.d.ts

*.tsbuildinfo

# TypeScript output files in source directories (should only be in dist/)
test-apps/**/*.d.ts
test-apps/**/*.d.ts.map
test-apps/**/*.js.map
!test-apps/**/tailwind.config.js
!test-apps/**/postcss.config.js

# Nuxt
.nuxt
.output

# Svelte
.svelte-kit
.svelte-types
# ...except the docs gate's stand-in for SvelteKit's generated `./$types`, which
# is a checked-in fixture and not build output. Git will not descend into an
# excluded directory, so the directory has to be re-included before the file can
# be. Without both lines the fixture is silently absent from every commit, and a
# pristine checkout throws ENOENT in sfc-check.mjs on the first page with
# `src/routes` — which is `ssr.mdx` and `svelte.mdx`.
!scripts/docs-snippets/fixtures/.svelte-kit
!scripts/docs-snippets/fixtures/.svelte-kit/**

# oh-my-claudecode
.omc
.omp
.omx

# Bundle analysis
dist-analyze
.claude/

# Playwright artifacts
playwright-report/
test-results/

# Smithers run store (ephemeral — never commit)
smithers.db
smithers.db-shm
smithers.db-wal

# mutation testing (scripts/mutation/run.mjs)
.stryker/
.stryker-tmp*/

# perf reference builds (scripts/perf.mjs --compare-ref)
.perf-ref/

# tarballs from `pnpm pack:release` (scripts/docs-snippets/link-sdk.mjs packs all
# fourteen so the docs gate can install them; they are build output, not source)
packages/*/*.tgz

# Local git worktrees used for parallel lots (never committed)
.worktrees/
