# Required. Absolute URL to the hosted in-context editor runtime.
# Default: latest @comvi/plugin-in-context-editor from npm via jsDelivr.
# Pin a version (e.g. @0.1.0) or major (@0) for predictable releases.
VITE_COMVI_EDITOR_SCRIPT_URL=https://cdn.jsdelivr.net/npm/@comvi/plugin-in-context-editor/dist/standalone.iife.js

# Local standalone editor runtime URL example (run plugin-in-context-editor's standalone build server):
# VITE_COMVI_EDITOR_SCRIPT_URL=http://127.0.0.1:5180/standalone.iife.js

# API base URL used by the in-context editor runtime.
# Production:
VITE_COMVI_API_BASE_URL=https://api.comvi.io

# Staging example:
# VITE_COMVI_API_BASE_URL=https://staging-api.comvi.io
