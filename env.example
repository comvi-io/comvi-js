# Required. Use the bundled runtime by default, or override with a local/hosted URL for development.
VITE_COMVI_EDITOR_SCRIPT_URL=vendor/comvi-in-context-editor.iife.js

# Local standalone editor runtime URL example:
# VITE_COMVI_EDITOR_SCRIPT_URL=http://127.0.0.1:5180/standalone.iife.js

# API base URL used by the in-context editor runtime.
# Production:
VITE_COMVI_API_BASE_URL=https://api.comvi.io

# Staging example:
# VITE_COMVI_API_BASE_URL=https://staging-api.comvi.io
