{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/next#build": {
      "outputs": [".next/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt4#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["build", "^build"]
    },
    "@comvi/chrome-extension#test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#size": {
      "outputs": [],
      "dependsOn": ["@comvi/core#build"]
    },
    "//#test-manifest": {
      "outputs": [],
      "dependsOn": ["@comvi/core#build", "@comvi/react#build", "@comvi/vue#build"],
      // The gate reads every wrapper's test files, which a root task hash does not cover.
      "cache": false
    },
    "//#bundler-matrix": {
      "outputs": [],
      "dependsOn": ["@comvi/core#build", "@comvi/react#build", "@comvi/vue#build"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["build", "^build"]
    },
    "test:watch": {
      "outputs": [],
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/next#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt4#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
