{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      // A cache HIT restores these files over the existing `dist/` and deletes
      // nothing, so files of earlier builds survive it. `pnpm build` therefore
      // removes every dist before turbo runs (tooling/clean-dist.mjs --all).
      "outputs": ["dist/**"],
      "dependsOn": ["^build"],
      // Every package's `build` ends in tooling/qualify-dts-specifiers.mjs, which lives
      // outside any package and so is invisible to turbo's default per-package hash.
      // Without naming it, editing the qualifier would restore an un-qualified `dist/`
      // straight from cache and the types gate would pass on stale output.
      // `$TURBO_DEFAULT$` keeps the normal per-package inputs — dropping it would
      // reduce every build's hash to these two files.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/qualify-dts-specifiers.mjs",
        "$TURBO_ROOT$/tooling/dts-specifier-scan.mjs"
      ]
    },
    "@test-apps/next#build": {
      "outputs": [".next/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/next16#build": {
      "outputs": [".next/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt4#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["build", "^build"]
    },
    "@comvi/chrome-extension#test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    // The extension's build pins its API origin (host_permissions, the proxy target) from
    // VITE_COMVI_API_BASE_URL; turbo's strict env mode would drop it, and it must be part of
    // the hash so a build for another origin is never restored from the cache.
    "@comvi/chrome-extension#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"],
      "env": ["VITE_COMVI_API_BASE_URL"]
    },
    // Gate E serves the built core, editor and framework fixtures to Chromium: every
    // workspace package the extension declares is built first (`^build`), so no manual
    // pre-step decides which dist is fresh. Never cached: it is a browser run.
    "@comvi/chrome-extension#test:e2e": {
      "outputs": [],
      "dependsOn": ["^build"],
      "cache": false,
      // playwright.config.ts reads CI (forbidOnly, reporters, no server reuse).
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "@comvi/chrome-extension#test:release": {
      "outputs": [],
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "//#size": {
      "outputs": [],
      // The framework fixtures (scripts/size-fixtures/framework/) resolve every
      // wrapper through its published exports map, so every wrapper dist must
      // exist.
      "dependsOn": [
        "@comvi/core#build",
        "@comvi/react#build",
        "@comvi/solid#build",
        "@comvi/svelte#build",
        "@comvi/vue#build",
        "@comvi/next#build",
        "@comvi/nuxt#build"
      ]
    },
    // Every package scripts/bundler-matrix/run.mjs packs into the fixture app
    // (the union of the active cases' `packages`). Listing fewer let the matrix
    // start against a missing dist — "@comvi/solid has no build output".
    "//#bundler-matrix": {
      "outputs": [],
      "dependsOn": [
        "@comvi/core#build",
        "@comvi/react#build",
        "@comvi/solid#build",
        "@comvi/svelte#build",
        "@comvi/vue#build",
        "@comvi/next#build"
      ]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["build", "^build"]
    },
    "test:watch": {
      "outputs": [],
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/next#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/next16#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt4#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
