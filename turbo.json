{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/next#build": {
      "outputs": [".next/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "@test-apps/nuxt4#build": {
      "outputs": [".nuxt/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["build", "^build"]
    },
    "@comvi/chrome-extension#test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#size": {
      "outputs": [],
      // The framework fixtures (scripts/size-fixtures/framework/) resolve every
      // wrapper through its published exports map, so every wrapper dist must
      // exist. @comvi/plugin-fetch-loader is listed explicitly: it is in
      // @comvi/next's server graph but not in its package dependencies.
      "dependsOn": [
        "@comvi/core#build",
        "@comvi/react#build",
        "@comvi/solid#build",
        "@comvi/svelte#build",
        "@comvi/vue#build",
        "@comvi/next#build",
        "@comvi/nuxt#build",
        "@comvi/locale-routing#build",
        "@comvi/plugin-fetch-loader#build"
      ]
    },
    // Every package scripts/bundler-matrix/run.mjs packs into the fixture app
    // (the union of the active cases' `packages`). Listing fewer let the matrix
    // start against a missing dist — "@comvi/solid has no build output".
    "//#bundler-matrix": {
      "outputs": [],
      "dependsOn": [
        "@comvi/core#build",
        "@comvi/react#build",
        "@comvi/solid#build",
        "@comvi/svelte#build",
        "@comvi/vue#build",
        "@comvi/locale-routing#build",
        "@comvi/next#build"
      ]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["build", "^build"]
    },
    "test:watch": {
      "outputs": [],
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/next#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@test-apps/nuxt4#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
