{
  "name": "@comvi/plugin-in-context-editor",
  "version": "0.7.1",
  "private": false,
  "type": "module",
  "description": "In-context translation editor plugin for Comvi — visual editing of translations in your app",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/plugin-in-context-editor"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation-editor",
    "in-context",
    "visual-editor",
    "comvi",
    "plugin",
    "localization"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": {
        "production": "./dist/production.d.ts",
        "default": "./dist/index.d.ts"
      },
      "production": "./dist/production.es.js",
      "default": "./dist/index.es.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.iife.js"
    }
  },
  "sideEffects": [
    "./dist/standalone.iife.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && vue-tsc && vite build && vite build --config vite.config.standalone.ts && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.tests.json",
    "build:standalone": "vite build --config vite.config.standalone.ts",
    "build:all": "pnpm build",
    "preview": "vite preview",
    "test:types": "vue-tsc --noEmit -p tsconfig.test-types.json",
    "test": "vitest run && pnpm test:types",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@comvi/core": "^0.7.0"
  },
  "devDependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/plugin-fetch-loader": "workspace:*",
    "@comvi/test-utils": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^21.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
