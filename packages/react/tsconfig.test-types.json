{
  // Two isolated programs: this one with generated catalogs (tests/types), and
  // tsconfig.test-types-untyped.json without (an augmentation is global to its program).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "noUnusedLocals": false
  },
  "include": ["src/**/*", "tests/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
