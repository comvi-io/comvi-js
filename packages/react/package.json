{
  "name": "@comvi/react",
  "version": "0.7.1",
  "type": "module",
  "description": "React binding for Comvi i18n: provider, hooks, <T> and useFormat()",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/react"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "react",
    "react-i18n",
    "react-intl",
    "hooks",
    "typescript",
    "type-safe",
    "comvi",
    "translation",
    "ssr",
    "ssg"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/comvi-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/comvi-react.dev.js",
      "default": "./dist/comvi-react.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "development": "./dist/comvi-react-format.dev.js",
      "default": "./dist/comvi-react-format.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && tsc --noEmit && vite build && vite build --config vite.config.dev.ts && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json && tsc --noEmit -p tsconfig.test-types-untyped.json",
    "test": "vitest run && pnpm test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@comvi/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
