{
  "name": "@comvi/editor",
  "version": "0.7.1",
  "private": false,
  "type": "module",
  "description": "In-context translation editor for Comvi — loaded on a page by the Comvi browser extension",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/editor"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation-editor",
    "in-context",
    "visual-editor",
    "comvi",
    "localization"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./standalone.iife.js": "./dist/standalone.iife.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/standalone.iife.js"
  ],
  "scripts": {
    "dev": "vite build --watch --config vite.config.standalone.ts",
    "build": "node ../../tooling/clean-dist.mjs && vue-tsc --noEmit -p tsconfig.app.json && vite build --config vite.config.standalone.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/test-utils": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^21.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
