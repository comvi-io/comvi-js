{
  // Type-checks the runtime tests (tests/**) that the build tsconfig leaves out. The type
  // tests (tests/types*) are their own programs (tsconfig.test-types*.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "rootDir": "../..",
    "types": ["svelte", "vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "tests/types/**", "tests/types-untyped/**"]
}
