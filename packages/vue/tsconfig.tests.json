{
  // Type-checks the runtime tests (tests/**) that the build tsconfig leaves out. The type
  // tests (tests/types*) are their own programs (tsconfig.test-types*.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "rootDir": "../..",
    "types": ["vitest/globals", "node"],
    "allowImportingTsExtensions": true,
    // e2e/ imports the package by name (its build aliases the built dist); here: the source.
    "paths": {
      "@comvi/vue": ["./src/index.ts"],
      "@comvi/vue/format": ["./src/format.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*.ts", "e2e/**/*.ts", "vite.entries.ts"],
  "exclude": ["node_modules", "dist", "e2e/dist", "tests/types/**", "tests/types-untyped/**"]
}
