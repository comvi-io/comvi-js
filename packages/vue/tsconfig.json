{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    // A map points at ../src, which is not packed: it would only send "go to
    // source" nowhere.
    "declarationMap": false,
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
