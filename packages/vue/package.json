{
  "name": "@comvi/vue",
  "version": "0.7.0",
  "type": "module",
  "description": "Vue 3 integration for Comvi — composables, components, and type-safe translations",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "vue",
    "vue3",
    "vue-i18n",
    "composition-api",
    "typescript",
    "type-safe",
    "comvi",
    "translation",
    "ssr"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/comvi-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/comvi-vue.dev.js",
      "default": "./dist/comvi-vue.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && vue-tsc && vite build && vite build --config vite.config.dev.ts && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run && pnpm test:types",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json && vue-tsc --noEmit -p tsconfig.keys-closed.json && tsc --noEmit -p tsconfig.keys-via-binding.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@comvi/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@comvi/test-utils": "workspace:*",
    "@comvi/vite-config": "workspace:*",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
