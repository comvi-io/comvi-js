{
  // Type-checks the test files and repo scripts' TS inputs that the build tsconfig
  // excludes. `tests/types/**` is checked by tests/types/negative.mjs instead: those
  // files are SUPPOSED to fail, line by line.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@comvi/core": ["./src/index.ts"],
      "@comvi/core/internal": ["./src/internal.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/types/**"],
  "references": []
}
