{
  "name": "@comvi/core",
  "version": "0.4.0",
  "type": "module",
  "description": "Type-safe, framework-agnostic i18n library with plugin architecture for JavaScript and TypeScript",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "typescript",
    "type-safe",
    "plugin",
    "comvi",
    "intl",
    "pluralization",
    "icu",
    "ssr",
    "ssg",
    "server-components"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/comvi-core.js",
  "unpkg": "./dist/comvi-core.global.prod.js",
  "jsdelivr": "./dist/comvi-core.global.prod.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/comvi-core.dev.js",
      "default": "./dist/comvi-core.js"
    },
    "./slim": {
      "types": "./dist/slim.d.ts",
      "development": "./dist/comvi-core-slim.dev.js",
      "default": "./dist/comvi-core-slim.js"
    },
    "./icu": {
      "types": "./dist/icu.d.ts",
      "development": "./dist/comvi-core-icu.dev.js",
      "default": "./dist/comvi-core-icu.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "development": "./dist/comvi-core-tags.dev.js",
      "default": "./dist/comvi-core-tags.js"
    },
    "./editor-bridge": {
      "types": "./dist/editor-bridge.d.ts",
      "development": "./dist/comvi-core-editor-bridge.dev.js",
      "default": "./dist/comvi-core-editor-bridge.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/comvi-core-tags.js",
    "./dist/comvi-core-tags.dev.js",
    "./dist/chunks/comvi-core-register-tags.js",
    "./dist/chunks/comvi-core-register-tags.dev.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && vite build --config vite.config.dev.ts && vite build --config vite.config.umd.ts",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json",
    "test": "vitest run && pnpm test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.9",
    "prettier": "^3.8.1",
    "terser": "^5.46.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
