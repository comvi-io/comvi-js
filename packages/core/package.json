{
  "name": "@comvi/core",
  "version": "0.7.1",
  "type": "module",
  "description": "Type-safe, framework-agnostic i18n runtime: ICU messages, typed t(), CDN loading",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "typescript",
    "type-safe",
    "plugin",
    "comvi",
    "intl",
    "pluralization",
    "icu",
    "ssr",
    "ssg",
    "server-components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/comvi-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/comvi-core.dev.js",
      "default": "./dist/comvi-core.js"
    },
    "./cdn": {
      "types": "./dist/cdn.d.ts",
      "development": "./dist/comvi-core-cdn.dev.js",
      "default": "./dist/comvi-core-cdn.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "development": "./dist/comvi-core-plugins.dev.js",
      "default": "./dist/comvi-core-plugins.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "development": "./dist/comvi-core-format.dev.js",
      "default": "./dist/comvi-core-format.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "development": "./dist/comvi-core-devtools.dev.js",
      "default": "./dist/comvi-core-devtools.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "development": "./dist/comvi-core-internal.dev.js",
      "default": "./dist/comvi-core-internal.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && tsc && vite build && vite build --config vite.config.dev.ts && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:types": "node tests/types/negative.mjs",
    "test": "vitest run && pnpm test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "terser": "^5.46.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
