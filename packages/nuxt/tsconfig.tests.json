{
  // Type-checks the runtime test files (tests/**) that tsconfig.typecheck.json
  // deliberately excludes. Mirrors tsconfig.test-types.json's `#…` alias mocks
  // (vitest resolves them the same way) and adds `#build/comvi.host`, which
  // only the runtime suites import. `tests/types.test-d.ts` stays with
  // tsconfig.test-types.json / `vitest --typecheck`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    // Tests run on Node 22 / happy-dom, not the ES2020 floor the shipped
    // build targets.
    "lib": ["ES2023", "DOM"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "#app": ["./tests/mocks/nuxt-app.ts"],
      "#build/comvi.setup": ["./tests/mocks/comvi-setup.ts"],
      "#build/comvi.host": ["./tests/mocks/comvi-host.ts"],
      "#components": ["./tests/mocks/nuxt-components.ts"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.d.ts", "./tests/**/*.test.ts", "./tests/mocks/**/*.ts"],
  "exclude": ["./coverage", "./dist", "./playground"]
}
