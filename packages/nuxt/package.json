{
  "name": "@comvi/nuxt",
  "version": "0.7.0",
  "type": "module",
  "description": "Nuxt module for Comvi i18n with type-checked keys, ICU plurals and a <T> component for markup inside translations",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "nuxt",
    "nuxt3",
    "nuxt-module",
    "ssr",
    "typescript",
    "type-safe",
    "comvi",
    "translation",
    "ssg",
    "server-components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./i18n": {
      "types": "./dist/runtime/i18n.d.ts",
      "import": "./dist/runtime/i18n.js"
    },
    "./setup": {
      "types": "./dist/runtime/setup.d.ts",
      "import": "./dist/runtime/setup.js"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "build": "node ../../tooling/clean-dist.mjs && nuxt-module-build build && tsc -p tsconfig.runtime.json && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "vendor": "node scripts/vendor-locale-routing.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run && pnpm test:types",
    "test:types": "vitest --typecheck.only --run --typecheck.include='tests/*.test-d.ts' --typecheck.tsconfig=tsconfig.test-types.json && tsc --noEmit -p tsconfig.keys-closed.json && tsc --noEmit -p tsconfig.keys-via-binding.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/vue": "workspace:*",
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "h3": "^1.15.11"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@comvi/locale-routing": "workspace:*",
    "@comvi/test-utils": "workspace:*",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^3.21.11",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "nuxt": "^3.21.11",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
