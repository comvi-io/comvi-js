{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "#app": ["./tests/mocks/nuxt-app.ts"],
      "#build/comvi.setup": ["./tests/mocks/comvi-setup.ts"],
      "#components": ["./tests/mocks/nuxt-components.ts"]
    }
  },
  // `./tests/*.test-d.ts`, not `./tests/**`: `tests/types-keys-closed/` is a
  // SECOND program (tsconfig.keys-closed.json) whose augmentation would close
  // `TranslationKeys` for this one, and `t-permissive.test-d.ts` here asserts
  // the OPEN path.
  "include": ["./src/types.ts", "./src/runtime/**/*.ts", "./tests/*.test-d.ts"],
  "exclude": ["./coverage", "./dist"]
}
