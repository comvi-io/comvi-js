{
  "name": "@comvi/next",
  "version": "0.7.1",
  "type": "module",
  "description": "Next.js App Router integration for Comvi — request-scoped server helper, RSC handover, middleware and locale routing",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/next"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "nextjs",
    "next",
    "app-router",
    "ssr",
    "typescript",
    "type-safe",
    "comvi",
    "translation",
    "middleware",
    "ssg",
    "server-components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "development": "./dist/server.dev.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "development": "./dist/client.dev.js",
      "default": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "development": "./dist/middleware.dev.js",
      "default": "./dist/middleware.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "development": "./dist/proxy.dev.js",
      "default": "./dist/proxy.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "development": "./dist/routing.dev.js",
      "default": "./dist/routing.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "development": "./dist/navigation.dev.js",
      "default": "./dist/navigation.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/server.js",
    "./dist/server.dev.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && tsc && vite build && vite build --config vite.config.dev.ts && node ../../tooling/qualify-dts-specifiers.mjs dist && esbuild src/plugin.ts --bundle --platform=node --format=cjs --target=node18 --external:next --log-level=warning --outfile=dist/plugin.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run && pnpm test:types",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src/",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@comvi/core": "^0.7.0",
    "@comvi/react": "^0.7.0",
    "next": "^15.5.28 || ^16.4.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/locale-routing": "workspace:*",
    "@comvi/react": "workspace:*",
    "@comvi/test-utils": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "next": "16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
