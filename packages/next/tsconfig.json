{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    // A map points at ../src, which is not packed: it would only send "go to
    // source" nowhere.
    "declarationMap": false,
    "rootDir": "./src",
    // The package's own config specifier, resolved to the stub. `dist/` does
    // not exist yet when `build` runs `tsc`, so the exports map cannot serve it.
    "paths": {
      "@comvi/next/config": ["./src/config.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
