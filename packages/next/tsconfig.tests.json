{
  // Type-checks the runtime test files (tests/**) that the build tsconfig
  // deliberately excludes. Kept as a SEPARATE project so the `tsc` in `build`
  // still emits from src only. `tests/types/**` stays with
  // tsconfig.test-types.json; `tests/js-contract/**` is .jsx by design (the
  // untyped JS-consumer contract) and `tests/dist/**` drives build artifacts
  // that carry no declarations, so neither is type-checkable here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", "dist", "tests/types/**", "tests/dist/**"]
}
