{
  "name": "@comvi/plugin-fetch-loader",
  "version": "0.7.0",
  "type": "module",
  "description": "HTTP translation loader plugin for Comvi — load translations from CDN or API",
  "license": "MIT",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comvi-io/comvi-js.git",
    "directory": "packages/plugin-fetch-loader"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation-loader",
    "cdn",
    "fetch",
    "http",
    "comvi",
    "plugin",
    "translations"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "node ../../tooling/clean-dist.mjs && tsc && vite build && node ../../tooling/qualify-dts-specifiers.mjs dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json",
    "test": "vitest run && pnpm test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@comvi/core": "^0.7.0"
  },
  "devDependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/test-utils": "workspace:*",
    "@comvi/vite-config": "workspace:*",
    "@types/node": "^22.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
