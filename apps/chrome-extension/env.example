# API base URL used by the in-context editor runtime.
VITE_COMVI_API_BASE_URL=https://api.comvi.io

# Optional. Path to a local standalone.iife.js build of @comvi/plugin-in-context-editor.
# The editor runtime is bundled into the extension package (MV3 forbids remote code).
# Defaults to ../../packages/plugin-in-context-editor/dist/standalone.iife.js
# COMVI_EDITOR_BUNDLE_PATH=/path/to/standalone.iife.js
