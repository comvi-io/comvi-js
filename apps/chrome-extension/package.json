{
  "name": "@comvi/chrome-extension",
  "version": "0.8.0",
  "private": true,
  "keywords": [],
  "homepage": "https://comvi.io",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src gate-e vite.config.ts vitest.config.ts playwright.config.ts playwright.system.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --exclude src/__tests__/artifacts.test.ts",
    "test:commit": "pnpm typecheck && pnpm test",
    "test:pr": "pnpm verify && pnpm test:e2e",
    "test:nightly": "pnpm test:pr",
    "test:release": "pnpm test:pr && pnpm zip",
    "verify": "pnpm typecheck && pnpm build && vitest run && pnpm audit",
    "gate-e:build": "COMVI_OUT_DIR=dist-gate-e vite build --mode gate-e",
    "gate-e:build:system": "COMVI_OUT_DIR=dist-system COMVI_TEST_PAGE_ORIGIN=http://127.0.0.1:8791 vite build --mode gate-e",
    "gate-e:serve": "node gate-e/mock-api-server.mjs",
    "test:e2e": "pnpm gate-e:build && pnpm gate-e:frameworks && playwright test",
    "test:layout-engines": "node gate-e/frameworks/build.mjs react vue solid svelte && playwright test --config playwright.engines.config.ts",
    "test:system:platform": "pnpm gate-e:build:system && playwright test --config playwright.system.config.ts",
    "zip": "pnpm build && COMVI_EXPECT_API_ORIGIN=https://api.comvi.io vitest run src/__tests__/artifacts.test.ts && cd dist && zip -r ../comvi-extension.zip .",
    "gate-e:frameworks": "node gate-e/frameworks/build.mjs"
  },
  "devDependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/editor": "workspace:*",
    "@comvi/next": "workspace:*",
    "@comvi/nuxt": "workspace:*",
    "@comvi/react": "workspace:*",
    "@comvi/solid": "workspace:*",
    "@comvi/svelte": "workspace:*",
    "@comvi/vue": "workspace:*",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "next": "^15.5.28",
    "nuxt": "^4.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.5",
    "vue": "^3.5.44"
  }
}
