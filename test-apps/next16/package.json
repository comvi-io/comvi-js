{
  "name": "@test-apps/next16",
  "description": "Next.js 16 copy of test-apps/next (the MANUAL setup), with Next 16's proxy.ts in place of middleware.ts. test-apps/next stays on Next 15, so between them both ends of @comvi/next's `next` peer range are built.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 2001",
