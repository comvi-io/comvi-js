{
  "name": "@test-apps/next16",
  "description": "Next.js 16 copy of test-apps/next (same src, proxy.ts in place of middleware.ts; run.mjs checks the copy). test-apps/next stays on Next 15, so between them both ends of @comvi/next's `next` peer range are built and driven in Chromium.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 2001",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@comvi/core": "workspace:*",
    "@comvi/next": "workspace:*",
    "@comvi/react": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  }
}
