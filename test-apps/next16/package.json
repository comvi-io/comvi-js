    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@comvi/next": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  }
}
