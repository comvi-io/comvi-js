{
  "name": "@comvi/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @comvi/plugin-in-context-editor build:all && vite build --watch",
    "build": "pnpm --filter @comvi/plugin-in-context-editor build:all && vite build",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm build && cd dist && zip -r ../comvi-extension.zip ."
  },
  "devDependencies": {
    "@comvi/plugin-in-context-editor": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.1.39",
    "tailwindcss": "4",
    "typescript": "~6.0.2",
    "vite": "^8.0.3"
  },
  "homepage": "https://comvi.io",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "keywords": []
}
