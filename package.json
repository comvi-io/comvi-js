{
  "name": "comvi",
  "version": "0.1.0",
  "description": "Type-safe i18n library for JavaScript — Vue, React, Svelte, SolidJS, Next.js, Nuxt",
  "author": "Comvi <hello@comvi.io> (https://comvi.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/comvi-io/comvi-js.git"
  },
  "homepage": "https://comvi.io",
  "bugs": {
    "url": "https://github.com/comvi-io/comvi-js/issues"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "dev:lib": "turbo run dev --filter='./packages/*' --concurrency=20",
    "dev:apps": "turbo run dev --concurrency=20",
    "build": "turbo run build --filter='./packages/*'",
    "build:all": "turbo run build",
    "test": "turbo run test",
    "test:commit": "turbo run test --filter='./packages/*' --filter='./apps/*'",
    "test:pr": "pnpm test:commit && pnpm build",
    "test:nightly": "pnpm test:coverage",
    "test:release-tools": "node --test tooling/qualify-dts-specifiers.test.mjs tooling/check-inlined-version.test.mjs tooling/check-package-contracts.test.mjs .github/scripts/create-combined-release.test.mjs scripts/root-changelog.test.mjs scripts/rc-version.test.mjs scripts/sync-peer-ranges.test.mjs scripts/version-release.test.mjs scripts/examples-verify.test.mjs scripts/examples-tools.test.mjs scripts/examples-e2e/lib.test.mjs scripts/audit-published.test.mjs && node --test scripts/wrapper-hooks-parity.test.mjs && node --test \"scripts/docs-snippets/*.test.mjs\" \"scripts/docs-quickstart/*.test.mjs\"",
    "test:release": "pnpm test:release-tools && pnpm test:pr && pnpm audit:package-contracts && pnpm check:publint && pnpm check:types-exports && pnpm check:inlined-version && pnpm check:snippets:types && pnpm check:strict-consumer && pnpm examples:e2e:all",
    "size": "node scripts/size-check.mjs",
    "check:strict-consumer": "node scripts/strict-consumer/run.mjs",
    "check:snippets": "node scripts/docs-snippets/run.mjs --readmes",
    "check:snippets:types": "node scripts/docs-snippets/run.mjs --readmes --typecheck --sdk-root .",
    "check:snippets:content": "node scripts/docs-snippets/run.mjs --content src/content/docs/docs/i18n --root \"${WWW_ROOT:?set WWW_ROOT to the www app directory}\"",
    "examples:verify": "node scripts/examples-verify.mjs",
    "docs:quickstart": "node scripts/docs-quickstart/run.mjs",
    "examples:e2e": "node scripts/examples-e2e/run.mjs",
    "examples:e2e:all": "node scripts/examples-e2e/run.mjs && node scripts/examples-e2e/run.mjs --cdn --no-build --no-pack",
    "examples:sync-locales": "node scripts/examples-sync-locales.mjs",
    "examples:use-tag": "node scripts/examples-use-tag.mjs",
    "bundler-matrix": "node scripts/bundler-matrix/run.mjs",
    "test:watch": "turbo run test:watch --concurrency=20",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter='./packages/*' --filter='./apps/*' --filter='./test-apps/*' && tsc -p scripts/examples-e2e/tsconfig.json",
    "extension:build": "turbo run build --filter @comvi/chrome-extension",
    "extension:test": "turbo run test --filter @comvi/chrome-extension",
    "extension:gate-e": "turbo run build --filter @comvi/plugin-in-context-editor && pnpm --filter @comvi/chrome-extension test:e2e",
    "extension:release": "turbo run build --filter @comvi/plugin-in-context-editor && pnpm --filter @comvi/chrome-extension test:release",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:package-contracts": "node tooling/check-package-contracts.mjs",
    "check:types-exports": "node scripts/check-types-exports.mjs",
    "pack:release": "pnpm --filter './packages/*' exec pnpm pack",
    "check:publint": "node tooling/run-publint.mjs",
    "check:inlined-version": "node tooling/check-inlined-version.mjs",
    "prepare": "husky",
    "lint:fix": "turbo run lint:fix",
    "audit:published": "node scripts/audit-published.mjs",
    "release:version": "node scripts/version-release.mjs",
    "perf": "node scripts/perf.mjs",
    "mutation": "node scripts/mutation/run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@comvi/vite-plugin": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.14",
    "playwright": "1.59.1",
    "prettier": "^3.8.1",
    "publint": "^0.3.21",
    "svelte-eslint-parser": "^1.6.0",
    "turbo": "^2.9.3",
    "vue-eslint-parser": "^10.4.0"
  },
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.svelte": [
      "pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "pnpm exec prettier --write"
    ]
  }
}
